---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const packagePrefill = Object.fromEntries(
  (await getCollection('packages')).map((entry) => [entry.slug, { name: entry.data.name }])
);

const full = site.openClients <= 0;
---
<Base title="Got a project in mind?" description="Bring a defined project and get a firm fixed-price bid from a senior DFW engineer: clear scope, milestones, and one price. Or ask about a maintenance plan.">
  <section class="section section--tight">
    <div class="container narrow">
      <p class="eyebrow">Project bid &amp; contact</p>
      <h1>Got a project in mind?</h1>
      <p class="lead" style="margin-bottom:8px">
        Tell me what you want built and I'll come back with a <strong>firm fixed-price bid</strong>:
        clear scope, milestones, and one price. No hourly surprises. A fixed-price project is also a
        low-risk way to work together before a subscription engagement.
      </p>

      <form class="form card" method="POST" action="https://api.web3forms.com/submit">
        <input type="hidden" name="access_key" value="20863029-453d-48f2-a6db-dc6673420bbd" />
        <input type="hidden" name="subject" value="New bid request from dfwfractionalfde.com" />
        <input type="hidden" name="from_name" value="DFW Fractional FDE" />
        <input type="hidden" name="redirect" id="redirect" value="https://dfwfractionalfde.com/thank-you/?type=contact" />
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

        <div class="field">
          <label for="topic">What's this about?</label>
          <select id="topic" name="topic">
            <option value="project">A fixed-price project</option>
            <option value="maintenance">Maintenance plan</option>
            <option value="general">Something else</option>
          </select>
        </div>

        <div class="two">
          <div class="field">
            <label for="name">Name *</label>
            <input id="name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email *</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
        </div>

        <div class="two">
          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="budget">Rough budget (optional)</label>
            <input id="budget" name="budget" placeholder="Helps me right-size the proposal" />
          </div>
        </div>

        <div class="field">
          <label for="message">Project details *</label>
          <textarea id="message" name="message" required placeholder="What do you want built, what does success look like, and is there a deadline?"></textarea>
          <span class="hint">The more detail you share, the tighter the fixed price I can quote.</span>
        </div>

        <button class="btn btn--primary" type="submit" style="width:100%">Request a bid →</button>
        <p class="muted" style="font-size:0.82rem;margin:14px 0 0">
          Looking for the ongoing subscription instead? <a class="textlink" href="/waitlist/">{full ? 'Join the waitlist →' : 'Start an engagement →'}</a>
        </p>
      </form>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ packagePrefill }}>
  // Send Web3Forms back to whichever host served the page (prod, dev proxy, localhost)
  document.getElementById('redirect').value = `${location.origin}/thank-you/?type=contact`;

  const params = new URLSearchParams(location.search);
  const topic = params.get('topic');
  if (topic) {
    const sel = document.getElementById('topic');
    for (const opt of sel.options) if (opt.value === topic) sel.value = topic;
  }

  const pkg = packagePrefill[params.get('package')];
  if (pkg) {
    const sel = document.getElementById('topic');
    for (const opt of sel.options) if (opt.value === 'project') sel.value = 'project';

    const message = document.getElementById('message');
    if (!message.value) {
      message.value = `I'd like to book the "${pkg.name}" fixed-price package.\n\nA bit about our setup:\n`;
    }
  }
</script>

<style>
  .narrow { max-width: 760px; }
  .form { margin-top: 26px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .textlink { color: var(--brand); font-weight: 600; }
  @media (max-width: 620px) { .two { grid-template-columns: 1fr; } }
</style>
