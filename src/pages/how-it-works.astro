---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const full = site.openClients <= 0;

const phases = [
  {
    n: '01', t: 'Discovery & on-site kickoff',
    d: '3 days on site in person, anywhere in the Metroplex. I learn how your business actually runs, map your data flows, and identify your highest-leverage AI and software opportunities. You leave with a prioritized roadmap and timelines for implementation, not a vague proposal.',
  },
  {
    n: '02', t: 'Embed & build',
    d: 'A flat monthly subscription. I join your standups, learn your domain, and ship production-grade AI continuously, re-prioritized with you each week. Because I\'m dedicated to your roadmap and not split across fifty tickets, context compounds quickly.',
  },
  {
    n: '03', t: 'Ship & compound',
    d: 'Working software in production, fast. The six-month minimum exists because real outcomes compound: early domain learning turns into accelerating delivery week over week. This is the opposite of a one-off project hand-off.',
  },
  {
    n: '04', t: 'Transition to maintenance',
    d: 'When the heavy build is done, step down to the Maintenance plan (up to 6 hrs/mo) to keep everything patched and healthy, or keep going with a full subscription when something new lands.',
  },
];

const diffs = [
  { t: 'On-site, in DFW', d: 'National subscription shops market "no meetings" and async-only. I do the opposite — in-person time across Dallas–Fort Worth is the whole point.' },
  { t: 'AI-native, in production', d: 'Not slideware. LLMs, agents, and ML pipelines built into systems that real people use, done precisely, not as vague "AI" hype.' },
  { t: 'One engineer, not a queue', d: 'You work directly with the engineer building your software. No account managers, no ticket triage, no work handed off to someone junior.' },
  { t: 'Flat monthly price', d: 'A predictable subscription instead of hourly billing games or six-figure project quotes. You always know what it costs.' },
];
---
<Base title="How it works" description="How a Fractional Forward Deployed Engineer engagement works: on-site discovery, embedded build, weekly shipping, and a graceful transition to maintenance.">
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h1 style="max-width:18ch">From on-site kickoff to software in production</h1>
      <p class="lead">
        A Fractional Forward Deployed Engineer engagement is a relationship, not a transaction.
        Here's exactly what working together looks like.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="timeline">
        {phases.map((p) => (
          <div class="phase">
            <div class="phase-n">{p.n}</div>
            <div class="phase-body">
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Why it's different</p>
      <h2 style="margin-bottom:30px">What makes this a Forward Deployed engagement</h2>
      <div class="grid grid--2">
        {diffs.map((d) => (
          <div class="card">
            <h3 style="margin-bottom:8px">{d.t}</h3>
            <p style="margin:0">{d.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <h2>{full ? 'Ready when a slot opens?' : 'Ready to get started?'}</h2>
      <p class="muted" style="max-width:50ch;margin:0 auto 24px">
        {full
          ? "I'm currently full. Join the waitlist to claim the next open slot."
          : "I'm currently accepting new engagements. Tell me about your business and I'll follow up to schedule a call."}
      </p>
      <div class="cta-row" style="justify-content:center">
        <a class="btn btn--primary" href="/waitlist/">{full ? 'Join the waitlist →' : 'Start an engagement →'}</a>
        <a class="btn btn--ghost" href="/pricing/">See pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .timeline { display: flex; flex-direction: column; gap: 4px; }
  .phase { display: grid; grid-template-columns: 84px 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--border-soft); }
  .phase:last-child { border-bottom: none; }
  .phase-n { font-family: var(--font); font-size: 1.6rem; font-weight: 700; color: var(--brand); }
  .phase-body h3 { margin-bottom: 8px; }
  .phase-body p { margin: 0; }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
  @media (max-width: 880px) { .phase { grid-template-columns: 60px 1fr; gap: 16px; } }
</style>
