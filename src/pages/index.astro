---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';
import { getCaseStudyPosts } from '../lib/case-studies';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';

// Fixed-price packages, ordered by their frontmatter `order` field.
const packages = (await getCollection('packages'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ slug: entry.slug, ...entry.data }));

// Keep the homepage rail to the 3 most recent case studies.
const featured = (await getCaseStudyPosts()).slice(0, 3);

const full = site.openClients <= 0;
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow eyebrow--accent hero-kicker">{site.region} · Fractional · On-site</p>
        <h1>An AI-native software engineer, forward deployed into your business.</h1>
        <p class="lead">I'm a fractional AI engineer in Dallas–Fort Worth for small and mid-sized businesses with little or no IT, including ones whose IT provider isn't helping with AI.</p>
        <p class="lead">
          You want to integrate AI into your business.  Your team may already be using it to speed up their own workflows.
          But you feel like you're missing the best that AI has to offer: transformative capabilities executing in a governed, auditable environment.
        </p>
        <p class="lead">
          I embed in your business, learn how you actually operate, and build that unifying AI layer for your team.
          No vendor agenda, no demos that never deploy. 
          Just the last mile of AI transformation that has to be built, not pitched.
        </p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/waitlist/">{full ? 'Join the waitlist →' : 'Start an engagement →'}</a>
          <a class="btn btn--ghost" href="#fixed-price">Buy a fixed-price package →</a>
        </div>
      </div>

      <div class="math-card">
        <span class="math-label">The math</span>
        <div class="math-rows">
          <div class="math-row"><span>Full-time senior AI engineer</span><strong>$300K+</strong></div>
          <div class="math-row"><span>Vendor ecosystem lock-in</span><strong>Indefinite</strong></div>
          <div class="math-row"><span>Hourly consulting</span><strong>Unbounded</strong></div>
          <div class="math-row math-row--accent"><span>Fractional FDE</span><strong>One flat monthly rate</strong></div>
        </div>
        <p class="math-note">No hourly rates. I work on your problem until it's done.</p>
      </div>
    </div>
  </section>

  <!-- Stat rail -->
  <section class="stat-rail">
    <div class="container stat-grid">
      <div class="stat"><div class="stat-n">6 mo</div><div class="stat-l">minimum engagement</div></div>
      <div class="stat"><div class="stat-n">Flat rate</div><div class="stat-l">no surprise bills</div></div>
      <div class="stat"><div class="stat-n">On-site</div><div class="stat-l">across the Metroplex</div></div>
      <div class="stat"><div class="stat-n">Direct</div><div class="stat-l">no 3rd-party agenda</div></div>
    </div>
  </section>

  <!-- What is an FDE -->
  <section class="section section--band">
    <div class="container fde">
      <p class="eyebrow eyebrow--accent fde-eyebrow">What is a Fractional FDE?</p>
      <div class="fde-body">
        <h2 class="serif-head">Big tech embeds an engineer with its most important customers. Now you can have one too.</h2>
        <p>
          A <strong>Forward Deployed Engineer</strong> practices business immersion: 
          embed in your environment, learn how you actually operate, and build the production-grade AI you need alongside your team.
        </p>
        <p>
          There's just one problem: Big tech's FDEs are working to get you locked into their stack.<br/>
          I work for you directly: doing what is best for your team and standing by my work with a flat-rate maintenance program.
          <a class="textlink" href="/about/">Meet your engineer →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Meet your engineer -->
  <section class="section section--band">
    <div class="container split">
      <div>
        <p class="eyebrow eyebrow--accent">Meet your engineer</p>
        <a class="textlink" href={site.owner.personalSite} target="_blank" rel="noopener">gordonburgett.net ↗</a>
      </div>
      <div class="engineer">
        <Image class="engineer-photo" src={headshot} alt="Gordon Burgett" widths={[200, 400]} sizes="200px" format="webp" loading="lazy" />
        <div class="engineer-body">
          <h2 class="serif-head">You're not hiring a firm. You're hiring me.</h2>
          <p>
            I'm Gordon Burgett - fifteen-plus years building production software, and
            leading AI workflow transformation in aerospace. Mobile apps, cloud services, and AI
            agents for companies that needed them to actually work beyond the demo.
          </p>
          <p>
            I run this practice solo, on purpose. The person you meet in discovery is the person
            in your standups six months later - writing the code and answering the phone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="engagement">
    <div class="container split">
      <div>
        <p class="engagement-eyebrow">The engagement</p>
        <a class="engagement-link" href="/pricing/">See pricing →</a>
      </div>
      <div>
        <h2 class="engagement-head">A subscription, not a project quote</h2>
        <div class="steps">
          <div class="step">
            <span class="step-n">01</span>
            <h3>Discovery &amp; on-site kickoff</h3>
            <p>
              3 days on site in person, anywhere in the Metroplex.
              I learn your business, map your data flows, and identify your highest-leverage opportunities.
              You get a roadmap and timelines for implementation.
            </p>
          </div>
          <div class="step">
            <span class="step-n">02</span>
            <h3>Embed &amp; build</h3>
            <p>
              A flat monthly subscription, shipping production-grade AI continuously, prioritized with you each week.
            </p>
          </div>
          <div class="step">
            <span class="step-n">03</span>
            <h3>Ship &amp; compound</h3>
            <p>
              Working software in production, fast. Six months gives us room to compound real outcomes and see the success.
            </p>
          </div>
          <div class="step">
            <span class="step-n">04</span>
            <h3>Transition to maintenance</h3>
            <p>When the heavy build is done, step down to a light maintenance plan — or keep going.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fixed price -->
  <section class="fixed" id="fixed-price">
    <div class="container fixed-head">
      <div class="fixed-head-copy">
        <p class="eyebrow eyebrow--accent">Fixed price</p>
        <h2 class="serif-head mt-0">Small, scoped, priced up front.</h2>
        <p class="fixed-intro">
          No retainer required. Good first steps if you'd rather see the work before you
          see a subscription.
        </p>
      </div>
      <span class="fixed-scroll-hint">Scroll for more →</span>
    </div>
    <div class="container">
      <div class="fixed-rail">
        {packages.map((pkg) => (
          <article class="svc-card">
            <div class="svc-media">
              <Image src={pkg.image} alt={pkg.imageAlt} widths={[420, 840]} sizes="420px" format="webp" loading="lazy" />
            </div>
            <div class="svc-body">
              <div class="svc-head">
                <h3><a class="svc-title-link" href={`/packages/${pkg.slug}/`}>{pkg.name}</a></h3>
                <div class="svc-price"><span class="amt">Get in touch</span><span class="term">{pkg.term}</span></div>
              </div>
              <p class="svc-blurb">
                {pkg.blurb}
                {pkg.caseStudySlug && (
                  <>
                    <br/>
                    <br/>
                    <a class="textlink" href={`/case-studies/${pkg.caseStudySlug}`}>{pkg.caseStudyLinkText}</a>
                  </>
                )}
              </p>
              <ul class="svc-list">
                {pkg.features.map((feature) => <li>{feature}</li>)}
              </ul>
              <a class="textlink svc-cta" href={`${pkg.bookingUrl}${pkg.bookingUrl.includes('?') ? '&' : '?'}package=${pkg.slug}`}>Book this →</a>
            </div>
          </article>
        ))}

        <article class="svc-card svc-card--more">
          <p class="eyebrow eyebrow--accent">Want to add AI to your product?</p>
          <p>I build AI agents that make consumers' lives easier.</p>
          <a class="textlink" href="/contact/?topic=project">Get in touch →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Insights / syndicated -->
  <section class="section">
    <div class="container">
      <div class="row-head">
        <div>
          <p class="eyebrow">Insights</p>
          <h2 class="mt-0">Case studies</h2>
        </div>
        <a class="textlink" href="/insights/">All writing →</a>
      </div>
      <div class="grid grid--2" style="margin-top:28px">
        {featured.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="waitlist-cta">
    <div class="container waitlist-inner">
      <div>
        <p class="engagement-eyebrow">{full ? 'Currently full' : 'Now accepting engagements'}</p>
        <h2 class="engagement-head">{full ? 'Join the waitlist' : 'Start an engagement'}</h2>
        <p class="waitlist-lead">
          {full
            ? "I keep the practice small to keep the work deep and the relationship real. Get on the waitlist and you'll be first to hear when a slot opens."
            : "I keep the practice small to keep the work deep and the relationship real. Tell me about your business and I'll follow up to schedule a call."}
        </p>
      </div>
      <div class="waitlist-actions">
        <a class="btn btn--waitlist" href="/waitlist/">{full ? 'Join the waitlist →' : 'Start an engagement →'}</a>
        <a class="engagement-link" href="/contact/?topic=project">Got a project in mind?</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 56px 0 40px; }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 0.85fr; gap: 60px; align-items: start; }
  .hero-kicker { margin-bottom: 14px; }
  .hero-copy h1 { margin: 0 0 22px; max-width: 16ch; }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 8px; }

  .math-card {
    background: var(--panel); border: 1px solid var(--border); border-left: 3px solid var(--brand);
    padding: 26px 26px 24px; display: flex; flex-direction: column; gap: 16px;
    box-shadow: var(--shadow-lg);
  }
  .math-label { font-family: var(--font); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-2); }
  .math-rows { display: flex; flex-direction: column; }
  .math-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--border-soft); font-size: 0.92rem; color: var(--muted); }
  .math-row strong { font-size: 1.04rem; font-weight: 600; white-space: nowrap; color: var(--text); }
  .math-row--accent { border-bottom: none; color: var(--brand); font-weight: 600; }
  .math-row--accent strong { color: var(--brand); }
  .math-note { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: 0.94rem; color: var(--muted-2); }

  .stat-rail { border-top: 2px solid var(--text); border-bottom: 1px solid var(--border-soft); }
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); padding: 0; }
  .stat { padding: 22px 24px; border-right: 1px solid var(--border-soft); }
  .stat:last-child { border-right: none; }
  .stat-n { font-size: 1.7rem; font-weight: 600; letter-spacing: -0.02em; }
  .stat-l { font-family: var(--font); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-2); padding-top: 6px; }

  .split { display: grid; grid-template-columns: 260px 1fr; gap: 52px; align-items: start; }
  .serif-head { font-family: var(--font-serif); font-weight: 400; font-size: 2rem; line-height: 1.24; letter-spacing: 0; max-width: 22ch; }
  .textlink { color: var(--brand); font-weight: 600; font-family: var(--font); }
  .textlink:hover { text-decoration: underline; }

  /* What is a Fractional FDE — label | prose (photo column re-add when .fde-figure returns) */
  .fde { display: grid; grid-template-columns: 260px 1fr; gap: 52px; align-items: start; }
  .fde-eyebrow { margin: 0; }
  .fde-body { display: flex; flex-direction: column; gap: 18px; max-width: 62ch; }
  .fde-body .serif-head { margin: 0; max-width: 34ch; }
  .fde-body p { margin: 0; font-size: 1.02rem; }
  .fde-figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .fde-figure img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    border: 1px solid var(--border); box-shadow: var(--shadow-lg);
  }
  .fde-figure figcaption {
    font-family: var(--font); font-size: 0.68rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--muted-2);
  }

  /* Fixed-price scroll rail */
  .fixed { padding: 76px 0; background: var(--band); border-top: 1px solid var(--border-soft); }
  .fixed-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 48px; }
  .fixed-head-copy { max-width: 620px; display: flex; flex-direction: column; gap: 10px; }
  .fixed-head-copy .serif-head { max-width: none; }
  .fixed-intro { margin: 0; font-family: var(--font-serif); font-size: 1rem; color: var(--muted); }
  .fixed-scroll-hint { flex: none; font-family: var(--font); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-2); }
  .fixed-rail {
    display: flex; gap: 26px; align-items: stretch;
    margin-top: 28px; padding-bottom: 10px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .svc-card {
    position: relative;
    flex: 0 0 420px; scroll-snap-align: start;
    display: flex; flex-direction: column;
    background: var(--panel); border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .svc-card:has(.svc-cta:hover) { border-color: var(--brand); }
  .svc-media { height: 190px; background: var(--navy); overflow: hidden; }
  .svc-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .svc-body { padding: 26px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .svc-head { display: flex; flex-direction: column; gap: 8px; }
  .svc-head h3 { margin: 0; font-size: 1.35rem; letter-spacing: -0.02em; }
  .svc-price { display: flex; align-items: baseline; gap: 10px; }
  .svc-price .amt { font-family: var(--mono); font-size: 1.5rem; font-weight: 500; color: var(--brand); }
  .svc-price .term { font-family: var(--font); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-2); }
  .svc-blurb { margin: 0; font-family: var(--font-serif); font-size: 0.98rem; line-height: 1.6; color: var(--muted); }
  .svc-list { list-style: none; margin: 0; padding: 12px 0 0; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 9px; }
  .svc-list li { position: relative; padding-left: 24px; font-size: 0.9rem; line-height: 1.55; color: var(--muted); }
  .svc-list li::before { content: '→'; position: absolute; left: 0; color: var(--brand); }
  .svc-cta { margin-top: auto; }
  /* Stretch the "Book this" link to cover the whole card. */
  .svc-cta::after {
    content: ''; position: absolute; inset: 0; z-index: 0;
  }
  /* Keep genuinely separate links (e.g. the case-study link) clickable. */
  .svc-blurb a { position: relative; z-index: 1; }
  .svc-title-link { position: relative; z-index: 1; color: inherit; text-decoration: none; }
  .svc-title-link:hover { text-decoration: underline; }
  .svc-card--more {
    flex-basis: 320px; justify-content: center; gap: 12px; padding: 34px;
    background: transparent; border: 1px dashed var(--border); box-shadow: none;
  }
  .svc-card--more p { margin: 0; font-family: var(--font-serif); font-size: 1.02rem; line-height: 1.5; color: var(--muted-2); }
  .svc-card--more .eyebrow { margin: 0; }

  .engineer { display: grid; grid-template-columns: 200px 1fr; gap: 40px; align-items: start; }
  .engineer-photo { width: 100%; max-width: 200px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--border); box-shadow: var(--shadow-lg); }
  .engineer-body p { font-size: 1.02rem; }

  /* Fixed navy bands — same regardless of site theme */
  .engagement, .waitlist-cta { background: var(--navy); color: var(--on-navy-text); }
  .engagement { padding: 72px 0; }
  .engagement-eyebrow {
    font-family: var(--font); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--on-navy-accent); margin: 0 0 14px;
  }
  .engagement-link { font-size: 0.92rem; font-weight: 600; color: var(--on-navy-accent); text-decoration: underline; font-family: var(--font); }
  .engagement-head { color: var(--on-navy-text); margin-bottom: 26px; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--on-navy-border); }
  .step { padding: 24px; border-right: 1px solid var(--on-navy-border); }
  .step:last-child { border-right: none; }
  .step-n { display: block; font-family: var(--font); font-size: 0.72rem; font-weight: 700; color: var(--on-navy-accent); margin-bottom: 8px; }
  .step h3 { color: var(--on-navy-text); font-size: 1.02rem; margin-bottom: 8px; }
  .step p { color: var(--on-navy-muted); font-size: 0.9rem; margin: 0; font-family: var(--font-serif); }

  .row-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }

  .waitlist-cta { padding: 60px 0; }
  .waitlist-inner { display: flex; align-items: flex-end; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .waitlist-lead { max-width: 52ch; font-size: 1.02rem; color: var(--on-navy-muted); margin: 0; }
  .waitlist-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .btn--waitlist { background: var(--on-navy-accent); color: #201502; box-shadow: 0 8px 22px -10px rgba(211, 168, 104, 0.5); }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .stat-grid { grid-template-columns: 1fr 1fr; }
    .stat:nth-child(2) { border-right: none; }
    .stat:nth-child(odd) { border-right: 1px solid var(--border-soft); }
    .stat:nth-child(n+3) { border-top: 1px solid var(--border-soft); }
    .split { grid-template-columns: 1fr; gap: 22px; }
    .fde { grid-template-columns: 1fr; gap: 24px; }
    .fde-figure { order: 2; }
    .engineer { grid-template-columns: 1fr; }
    .engineer-photo { max-width: 160px; }
    .steps { grid-template-columns: 1fr; }
    .step { border-right: none; border-bottom: 1px solid var(--on-navy-border); }
    .step:last-child { border-bottom: none; }
    .row-head { flex-direction: column; align-items: flex-start; gap: 10px; }
    .fixed-head { flex-direction: column; align-items: flex-start; gap: 14px; }
    .svc-card { flex-basis: 82%; }
    .svc-card--more { flex-basis: 70%; }
  }
</style>
