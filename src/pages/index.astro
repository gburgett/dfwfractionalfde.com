---
import Base from '../layouts/Base.astro';
import Availability from '../components/Availability.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';
import { caseStudies } from '../data/posts';

const featured = caseStudies;
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <Availability />
      <p class="eyebrow" style="margin-top:22px">Dallas–Fort Worth · Fractional · On-site</p>
      <h1>
        An AI-native software engineer, <span class="grad">forward deployed</span> into your business.
      </h1>
      <p class="lead">
        You know you need to do something with AI, but everyone seems like snake-oil salesmen.
        I embed in your business, learn your operational reality, and ship production-grade AI and
        software. No vendor agenda, no demos that never deploy. This is the last mile of
        AI transformation, and it needs to be built, not pitched.
      </p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/waitlist/">Join the waitlist →</a>
        <a class="btn btn--ghost" href="/how-it-works/">See how it works</a>
      </div>
      <div class="hero-meta">
        <div><strong>6&nbsp;mo</strong><span>minimum engagement</span></div>
        <div><strong>Flat Rate</strong><span>no suprise bills</span></div>
        <div><strong>On-site</strong><span>across the Metroplex</span></div>
        <div><strong>Vendor-agnostic</strong><span>no locked-in agenda</span></div>
      </div>
    </div>
  </section>

  <!-- What is an FDE -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow">What is a Fractional FDE?</p>
          <h2>Big-tech embeds an engineer with their most important customers. Now you can have one too: technology-agnostic, independent, and on-site in DFW.</h2>
        </div>
        <div>
          <p>
            A <strong>Forward Deployed Engineer</strong> doesn't hand you a proposal and disappear.
            They practice <strong>business immersion</strong>: embed in your environment, learn how you
            actually operate, and build the production-grade AI and software you need, sitting right
            alongside your team.
          </p>
          <p>
            <strong>Fractional</strong> means you get that senior, AI-native capability without a
            $300K+ full-time hire or commitment to a single vendor's ecosystem.
            One flat monthly subscription, no hourly rates. We work on your problem until it's done.
          </p>
          <a class="textlink" href="/about/">Meet your engineer →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow center" style="justify-content:center">Core capabilities</p>
      <h2 class="center" style="margin-bottom:8px">What I build, embedded with you</h2>
      <p class="center muted" style="max-width:60ch;margin:0 auto 40px">
        Fifteen-plus years of software engineering, currently leading AI workflow transformation
        in aerospace, now working inside your business.
      </p>
      <div class="grid grid--3">
        <div class="card cap">
          <h3>AI Agents &amp; AI-Native Engineering</h3>
          <p>LLM integration, <strong>AI Agents that reason through multi-step workflows and execute autonomously</strong>, and AI Governance built into real products, not demos. I ship production-grade AI that does work, safely and in production.</p>
          {/* TODO: case studies */}
        </div>
        <div class="card cap">
          <h3>Systems Architecture</h3>
          <p>Custom mobile apps, cloud-native services, and clean APIs designed to scale with your business and survive contact with real users.</p>
        </div>
        <div class="card cap">
          <h3>Embedded Delivery &amp; Business Immersion</h3>
          <p><strong>Business immersion</strong> is the first principle of forward deployed engineering. I work inside your business (on-site in DFW, in your standups, learning your domain) then build production software that fits your operational reality.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">The engagement</p>
      <h2 style="margin-bottom:36px">A subscription, not a project quote</h2>
      <div class="grid grid--2 steps">
        <div class="step">
          <span class="step-n">01</span>
          <div>
            <h3>Discovery & on-site kickoff</h3>
            <p>We meet in person, anywhere in the Metroplex. I learn your business, your data, and your highest-leverage opportunities.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-n">02</span>
          <div>
            <h3>Embed & build</h3>
            <p>I deploy forward into your team on a flat monthly subscription, shipping production-grade software and AI continuously, prioritized with you each week.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-n">03</span>
          <div>
            <h3>Ship & compound</h3>
            <p>Working software in production, fast. A minimum six-month engagement gives us room to compound real outcomes, not one-off projects.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-n">04</span>
          <div>
            <h3>Transition to maintenance</h3>
            <p>When the heavy build is done, step down to a light maintenance plan to keep everything healthy, or keep going!</p>
          </div>
        </div>
      </div>
      <div class="cta-row" style="margin-top:36px">
        <a class="btn btn--primary" href="/pricing/">See pricing →</a>
        <a class="btn btn--ghost" href="/how-it-works/">Full breakdown</a>
      </div>
    </div>
  </section>

  <!-- Insights / syndicated -->
  <section class="section section--tight">
    <div class="container">
      <div class="row-head">
        <div>
          <p class="eyebrow">Insights</p>
          <h2 class="mt-0">Case studies</h2>
        </div>
        <a class="textlink" href="/insights/">All writing →</a>
      </div>
      <div class="grid grid--3" style="margin-top:28px">
        {featured.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-panel">
        <p class="eyebrow center" style="justify-content:center">Currently full</p>
        <h2 class="center mt-0">Join the waitlist</h2>
        <p class="center muted" style="max-width:54ch;margin:14px auto 26px">
          I keep the practice small to keep the work deep and the relationship real.
          Get on the waitlist and you'll be first to hear when a slot opens.
        </p>
        <div class="cta-row" style="justify-content:center">
          <a class="btn btn--primary" href="/waitlist/">Join the waitlist →</a>
          <a class="btn btn--ghost" href="/contact/">Got a project in mind?</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 70px 0 30px; }
  .hero h1 { margin: 14px 0 18px; max-width: 16ch; }
  .grad { background: linear-gradient(120deg, var(--brand), var(--brand-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
  .hero-meta {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px;
    margin-top: 48px; padding-top: 30px; border-top: 1px solid var(--border-soft);
  }
  .hero-meta strong { display: block; font-size: 1.5rem; color: var(--text); }
  .hero-meta span { color: var(--muted-2); font-size: 0.88rem; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .textlink { color: var(--brand); font-weight: 600; }
  .textlink:hover { text-decoration: underline; }

  .cap h3 { margin-bottom: 10px; }
  .ticks { list-style: none; padding: 0; margin: 16px 0 0; }
  .ticks li { position: relative; padding-left: 26px; margin-bottom: 9px; color: var(--muted); font-size: 0.94rem; }
  .ticks li::before {
    content: '✓'; position: absolute; left: 0; top: 0;
    color: var(--brand); font-weight: 700;
  }

  .steps { gap: 20px; }
  .step { display: flex; gap: 18px; padding: 24px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-soft); }
  .step-n { font-family: var(--mono); font-size: 0.95rem; font-weight: 600; color: var(--brand); }
  .step h3 { margin-bottom: 6px; }
  .step p { margin: 0; font-size: 0.95rem; }

  .row-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }

  .cta-panel {
    background: linear-gradient(160deg, var(--panel-2), var(--bg-soft));
    border: 1px solid var(--border); border-radius: 22px; padding: 56px 32px;
    box-shadow: var(--shadow);
  }

  @media (max-width: 880px) {
    .split { grid-template-columns: 1fr; gap: 22px; }
    .hero-meta { grid-template-columns: 1fr 1fr; }
  }
</style>
