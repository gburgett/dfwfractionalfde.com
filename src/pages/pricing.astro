---
import Base from '../layouts/Base.astro';
import Availability from '../components/Availability.astro';
import { site } from '../data/site';

const full = site.openClients <= 0;
---
<Base title="Pricing" description="Up-front, subscription pricing for a Fractional Forward Deployed Engineer in DFW. Maintenance plans and fixed-price project bids available.">
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow center" style="justify-content:center">Pricing</p>
      <h1 class="center" style="margin-bottom:14px">Flat pricing, no surprises</h1>
      <p class="center muted" style="max-width:62ch;margin:0 auto 22px">
        The core offering is a flat monthly subscription.
        Just like hiring a full-time software engineer, you get predictable work done at a pace you're comfortable with.
        Weekly progress reports give you insight into what is being built, and biweekly roadmapping meetings give you
        directional control.
        Regular on-site visits build trust with the team and enable us to ship only what you actually need.
      </p>
      <div class="center"><Availability /></div>
    </div>
  </section>

  <section class="section" style="padding-top:8px">
    <div class="container">
      <div class="pricing">
        <!-- Maintenance (left, minimal) -->
        <div class="plan plan--minimal">
          <div class="plan-head">
            <span class="plan-kind">Maintenance only</span>
            <div class="plan-price"><span class="amt">$999</span><span class="per">/ mo</span></div>
            <p class="plan-sub">Keep the lights on after a build engagement.</p>
          </div>
          <ul class="plan-list">
            <li>Bug fixes &amp; dependency upkeep</li>
            <li>Uptime &amp; security patching</li>
            <li>Email support, same-week response.</li>
            <li class="muted-li">Available <strong>after</strong> a subscription engagement</li>
          </ul>
          <a class="btn btn--ghost plan-btn" href="/contact/?topic=maintenance">Ask about maintenance</a>
          <p class="plan-foot">A graceful off-ramp: step down from active build to light upkeep without losing your engineer.</p>
          <p class="plan-fine">Up to 6 hours of work per month, averaged over 3 months.</p>
        </div>

        <!-- Subscription (middle, featured) -->
        <div class="plan plan--featured">
          <span class="ribbon">The engagement</span>
          <div class="plan-head">
            <span class="plan-kind">Fractional FDE Subscription</span>
            <div class="plan-price"><span class="amt">$6,995</span><span class="per">/ mo</span></div>
            <p class="plan-sub">A senior, AI-native engineer embedded in your business.</p>
          </div>
          <ul class="plan-list">
            <li>One forward deployed engineer, dedicated to your roadmap</li>
            <li>Continuous build: AI features, software, integrations</li>
            <li>On-site kickoff &amp; ongoing in-person time across DFW</li>
            <li>A roadmap with concrete milestones &amp; integration timelines</li>
            <li>Bi-weekly prioritization with you; ship every week</li>
            <li>Direct access: no ticket queue, no account managers</li>
            <li><strong>6-month minimum</strong> engagement</li>
          </ul>
          <a class="btn btn--primary plan-btn" href="/waitlist/">{full ? 'Join the waitlist →' : 'Start an engagement →'}</a>
          <p class="plan-foot">
            {full
              ? "Currently full. The waitlist is the only way in; you'll be first to know when a slot opens."
              : "Now accepting new engagements. Tell me about your business and I'll follow up to schedule a call."}
          </p>
          <p class="plan-fine">Up to 40 hours of work per month, averaged over 3 months.</p>
        </div>

        <!-- Project bid (right) -->
        <div class="plan plan--project">
          <div class="plan-head">
            <span class="plan-kind">Got a project in mind?</span>
            <div class="plan-price"><span class="amt">Fixed</span><span class="per">bid</span></div>
            <p class="plan-sub">A defined scope with one firm price.</p>
          </div>
          <ul class="plan-list">
            <li>Firm fixed-price proposal</li>
            <li>Clear scope, milestones &amp; deadline</li>
            <li>Great for a one-off build or proof of concept</li>
            <li>No monthly commitment</li>
            <li>A low-risk way to work together first</li>
          </ul>
          <a class="btn btn--ghost plan-btn" href="/contact/?topic=project">Request a bid →</a>
          <p class="plan-foot">Tell me what you want built. I'll come back with a fixed price and timeline. No hourly surprises.</p>
        </div>
      </div>

      <p class="center muted disclaimer">
        Subscription pricing reflects current market rates for fractional, senior engineering in
        Dallas–Fort Worth. Engagements require a {site.minEngagementMonths}-month minimum so we can
        compound real outcomes rather than ship disconnected one-offs.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--tight">
    <div class="container narrow">
      <h2 class="center" style="margin-bottom:28px">Pricing questions, answered</h2>
      <div class="faq">
        <details>
          <summary>{full ? 'Why a waitlist?' : 'How do we get started?'}</summary>
          <p>
            {full
              ? "Forward deployed means genuinely embedded. Each engagement takes real focus to learn a business deeply and build for it well, so when my calendar is full, new engagements start from the waitlist. You'll be first to know when a slot opens."
              : "Fill out the form and I'll follow up to schedule a call and confirm scope. Forward deployed means genuinely embedded, so I keep the number of concurrent clients limited to what I can give real focus — when the calendar fills up, new engagements move to a waitlist."}
          </p>
        </details>
        <details>
          <summary>Why a six-month minimum?</summary>
          <p>Real software and AI outcomes compound. The first weeks are spent learning your domain
          and standing things up; the value shows up as that knowledge turns into shipped product
          month after month. Six months is the floor for that to pay off.</p>
        </details>
        <details>
          <summary>What happens when the build is done?</summary>
          <p>You can transition to the <strong>Maintenance only</strong> plan ($999/mo) to keep
          everything patched and healthy, or scope a fixed-price project when something new comes
          up. You're never forced to keep paying for full build capacity you no longer need.</p>
        </details>
        <details>
          <summary>Can we start with a fixed-price project instead?</summary>
          <p>Absolutely. A firm fixed-price project is a low-risk way to work together before
          committing to a subscription. <a href="/contact/?topic=project">Request a bid</a> and
          we'll scope it.</p>
        </details>
      </div>
    </div>
  </section>
</Base>

<style>
  .pricing { display: grid; grid-template-columns: 1fr 1.18fr 1fr; gap: 22px; align-items: stretch; }
  .plan {
    display: flex; flex-direction: column;
    border: 1px solid var(--border); border-radius: var(--radius); padding: 30px 26px;
    background: var(--panel); box-shadow: var(--shadow);
    position: relative;
  }
  .plan--minimal, .plan--project { margin-top: 18px; }
  .plan--featured {
    border-color: var(--brand);
    background: var(--navy); color: var(--on-navy-text);
    box-shadow: var(--shadow-lg);
  }
  .plan--featured .plan-sub, .plan--featured .plan-list li { color: var(--on-navy-muted); }
  .plan--featured .plan-foot, .plan--featured .plan-fine, .plan--featured .per { color: var(--on-navy-muted); }
  .ribbon {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    background: var(--on-navy-accent); color: #201502;
    font-family: var(--font); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
    font-weight: 700; padding: 6px 14px; white-space: nowrap;
  }
  .plan-kind { font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brand); font-family: var(--font); font-weight: 600; }
  .plan--featured .plan-kind { color: var(--on-navy-accent); }
  .plan-price { display: flex; align-items: baseline; gap: 8px; margin: 14px 0 6px; }
  .amt { font-size: 2.6rem; font-weight: 700; letter-spacing: -0.03em; }
  .per { color: var(--muted-2); font-size: 0.95rem; }
  .plan-sub { font-size: 0.95rem; min-height: 2.8em; }
  .plan-list { list-style: none; padding: 0; margin: 18px 0 22px; flex: 1; }
  .plan-list li { position: relative; padding-left: 26px; margin-bottom: 11px; font-size: 0.94rem; color: var(--muted); }
  .plan-list li::before { content: '✓'; position: absolute; left: 0; color: var(--brand); font-weight: 700; }
  .plan--featured .plan-list li::before { color: var(--on-navy-accent); }
  .plan--featured .btn--primary { background: var(--on-navy-accent); color: #201502; box-shadow: 0 8px 22px -10px rgba(211, 168, 104, 0.5); }
  .plan-list .muted-li { color: var(--muted-2); }
  .plan-list .muted-li::before { content: '→'; color: var(--accent); }
  .plan-btn { width: 100%; }
  .plan-foot { font-size: 0.84rem; color: var(--muted-2); margin: 16px 0 0; }
  .plan-fine { font-size: 0.78rem; color: var(--muted-2); opacity: 0.7; margin: 8px 0 0; font-style: italic; }
  .disclaimer { max-width: 70ch; margin: 36px auto 0; font-size: 0.88rem; }

  .narrow { max-width: 760px; }
  .faq details {
    border: 1px solid var(--border); border-radius: var(--radius); padding: 4px 20px; margin-bottom: 12px;
    background: var(--band);
  }
  .faq summary { cursor: pointer; font-weight: 600; padding: 14px 0; list-style: none; font-family: var(--font); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; float: right; color: var(--brand); font-size: 1.2rem; }
  .faq details[open] summary::after { content: '–'; }
  .faq p { margin: 0 0 16px; font-size: 0.95rem; }
  .faq a { color: var(--brand); }

  @media (max-width: 980px) {
    .pricing { grid-template-columns: 1fr; }
    .plan--minimal, .plan--project { margin-top: 0; }
    .plan--featured { order: -1; }
  }
</style>
