---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section center">
    <div class="container">
      <p class="eyebrow center" style="justify-content:center">404</p>
      <h1>That page didn't deploy</h1>
      <p class="muted" style="max-width:42ch;margin:0 auto 26px">
        The page you're looking for doesn't exist. Let's get you back on track.
      </p>
      <div class="cta-row" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href="/">Home</a>
        <a class="btn btn--ghost" href="/pricing/">Pricing</a>
        <a class="btn btn--ghost" href="/waitlist/">Waitlist</a>
      </div>
    </div>
  </section>
</Base>
