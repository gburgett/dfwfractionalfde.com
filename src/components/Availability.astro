---
import { site } from '../data/site';
const { openClients } = site;
const full = openClients <= 0;
---
<div class={`avail ${full ? 'avail--full' : 'avail--open'}`}>
  <span class="dot"></span>
  {full ? (
    <span><strong>Currently full.</strong> Join the waitlist.</span>
  ) : (
    <span><strong>Accepting new engagements now.</strong></span>
  )}
</div>

<style>
  .avail {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.88rem; padding: 9px 16px; border-radius: var(--radius);
    border: 1px solid var(--border); background: var(--band);
    font-family: var(--font);
  }
  .avail strong { color: var(--text); }
  .avail span { color: var(--muted-2); }
  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .avail--full .dot { background: var(--brand); }
  .avail--open .dot { background: var(--muted-2); }
</style>
