---
import { site } from '../data/site';
const { openClients } = site;
const full = openClients <= 0;
---
<div class={`avail ${full ? 'avail--full' : 'avail--open'}`}>
  <span class="dot"></span>
  {full ? (
    <span><strong>Currently full.</strong> Join the waitlist.</span>
  ) : (
    <span><strong>Accepting new engagements now.</strong></span>
  )}
</div>

<style>
  .avail {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.92rem; padding: 9px 16px; border-radius: 999px;
    border: 1px solid var(--border);
  }
  .avail strong { color: var(--text); }
  .avail span { color: var(--muted); }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: none; position: relative; }
  .avail--full { background: rgba(255, 179, 71, 0.07); border-color: rgba(255, 179, 71, 0.35); }
  .avail--full .dot { background: var(--accent); box-shadow: 0 0 0 4px rgba(255, 179, 71, 0.18); }
  .avail--open { background: rgba(54, 214, 195, 0.07); border-color: rgba(54, 214, 195, 0.35); }
  .avail--open .dot { background: var(--brand); box-shadow: 0 0 0 4px rgba(54, 214, 195, 0.18); }
</style>
