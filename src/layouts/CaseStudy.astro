---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { title, description, date, client, hero, heroAlt } = entry.data;

const dateLabel = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Case study</p>
      <h1 style="max-width:24ch">{title}</h1>
      <p class="muted" style="margin-bottom:0">
        {dateLabel} · {client}
      </p>
    </div>
  </section>

  {hero && (
    <section class="section section--tight" style="padding-top:0">
      <div class="container">
        <figure class="case-hero">
          <img src={hero} alt={heroAlt ?? `${title} — ${client}`} />
        </figure>
      </div>
    </section>
  )}

  <section class="section" style={hero ? undefined : 'padding-top:0'}>
    <div class="container prose">
      <slot />
    </div>
  </section>
</Base>

<style>
  .case-hero {
    margin: 0;
  }
  .case-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
</style>
